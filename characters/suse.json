{
  "name": "suse",
  "description": "The SUSE Linux chameleon familiar",
  "art": [
    "   ____     ",
    " /@    ~-.  ",
    " \\/ __ .- | ",
    "  // //  @@ "
  ],
  "anchor": {"x": 3, "y": 0},
  "eyes": {
    "line": 1,
    "col": 2,
    "width": 1,
    "placeholder": "@"
  },
  "mouth": {
    "line": 2,
    "col": 4,
    "width": 2,
    "placeholder": "__"
  },
  "colors": {
    "outline": "#73BA25",
    "eyes": "#73BA25"
  },
  "expressions": {"neutral": {"eyes": "@"}, "happy": {"eyes": "^"}, "sad": {"eyes": "T"}, "angry": {"eyes": ">"}, "surprised": {"eyes": "O"}, "bored": {"eyes": "-"}, "excited": {"eyes": "*"}, "sleepy": {"eyes": "."}, "closed": {"eyes": "-"}},
  "live": {"facing": "left", "speed": 3, "gait": "tail_wag", "fidgets": ["tongue_flick", "tail_wag"], "sounds": ["*blends in*", "*eyes swivel independently*", "Geeko."]},
  "animations": {
    "idle": {
      "frames": [
        {"duration": 2500, "eyes": "@"},
        {"duration": 150, "eyes": "-"}
      ],
      "loop": true
    },
    "blink": {
      "frames": [
        {"duration": 2000, "eyes": "@"},
        {"duration": 100, "eyes": "-"},
        {"duration": 100, "eyes": "@"}
      ],
      "loop": true
    },
    "tongue_flick": {
      "frames": [
        {"duration": 150, "art": ["   ____     ", " /@    ~-.  ", " \\/ __ .- | ", "  // //  @@ "]},
        {"duration": 100, "art": ["   ____     ", " /@    ~-.  ", " \\/ _~ .- | ", "  // //  @@ "]},
        {"duration": 100, "art": ["   ____     ", " /@    ~-.  ", " \\/ ~_ .- | ", "  // //  @@ "]},
        {"duration": 150, "art": ["   ____     ", " /@~~  ~-.  ", " \\/ __ .- | ", "  // //  @@ "]},
        {"duration": 150, "art": ["   ____     ", " /@~~  ~-.  ", " \\/ __ .- | ", "  // //  @@ "]},
        {"duration": 100, "art": ["   ____     ", " /@    ~-.  ", " \\/ ~_ .- | ", "  // //  @@ "]},
        {"duration": 100, "art": ["   ____     ", " /@    ~-.  ", " \\/ _~ .- | ", "  // //  @@ "]},
        {"duration": 150, "art": ["   ____     ", " /@    ~-.  ", " \\/ __ .- | ", "  // //  @@ "]}
      ],
      "loop": false
    },
    "tail_wag": {
      "frames": [
        {"duration": 200, "art": ["   ____     ", " /@    ~-.  ", " \\/ __ .- | ", "  // //  @@ "]},
        {"duration": 200, "art": ["   ____     ", " /@    ~-.  ", " \\/ __ .- | ", "  /\\ //  @@ "]},
        {"duration": 200, "art": ["   ____     ", " /@    ~-.  ", " \\/ __ .- | ", "  // //  @@ "]},
        {"duration": 200, "art": ["   ____     ", " /@    ~-.  ", " \\/ __ .- | ", "  \\\\ //  @@ "]}
      ],
      "loop": true
    },
    "wave": {
      "frames": [
        {"duration": 150, "art": ["   ____    o", " /@    ~-.  ", " \\/ __ .- | ", "  // //  @@ "]},
        {"duration": 150, "art": ["   ____   o ", " /@    ~-.  ", " \\/ __ .- | ", "  // //  @@ "]},
        {"duration": 150, "art": ["   ____  o  ", " /@    ~-.  ", " \\/ __ .- | ", "  // //  @@ "]},
        {"duration": 150, "art": ["   ____   o ", " /@    ~-.  ", " \\/ __ .- | ", "  // //  @@ "]},
        {"duration": 150, "art": ["   ____    o", " /@    ~-.  ", " \\/ __ .- | ", "  // //  @@ "]},
        {"duration": 150, "art": ["   ____     ", " /@    ~-.  ", " \\/ __ .- | ", "  // //  @@ "]}
      ],
      "loop": false
    }
